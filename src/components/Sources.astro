---
interface Props { sources: { title: string; url: string }[]; retrieved?: string }
const { sources, retrieved } = Astro.props;
const host = (u: string) => new URL(u).hostname;
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="src-h">
    <h2 id="src-h">Sources</h2>
    <ol>
      {sources.map((s) => (
        <li><a href={s.url} rel="nofollow noopener">{s.title}</a>{retrieved && <> (checked {retrieved})</>}<span class="host">{host(s.url)}</span></li>
      ))}
    </ol>
  </section>
)}
