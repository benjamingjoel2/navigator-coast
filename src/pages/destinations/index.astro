---
import Listing from '../../components/Listing.astro';
import { allPosts } from '../../data/posts';
import { categoryByKey, REGIONS } from '../../data/site';
const cat = categoryByKey('destinations');
const posts = (await allPosts()).filter((p) => p.data.categories.includes('destinations') || p.data.regions.length > 0 && p.data.categories.includes('itineraries'));
---
<Listing title={cat.name} intro="Lisbon, Porto and the Douro, the Alentejo, the Algarve, Centro, Madeira and the Azores: seven very different Portugals. Pick a region, or read across them all." path={cat.path} posts={posts}
  crumbs={[{ name: cat.name, path: cat.path }]} chips={REGIONS.map((r) => ({ name: r.name, path: r.path }))} chipsLabel="Regions" />
