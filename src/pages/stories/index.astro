---
import Listing from '../../components/Listing.astro';
import { allPosts } from '../../data/posts';
import { CATEGORIES } from '../../data/site';
const posts = await allPosts();
---
<Listing title="All stories" intro="Every Navigator Coast story, newest first." path="/stories/" posts={posts}
  crumbs={[{ name: 'All stories', path: '/stories/' }]} chips={CATEGORIES.map((c) => ({ name: c.name, path: c.path }))} chipsLabel="Categories" />
