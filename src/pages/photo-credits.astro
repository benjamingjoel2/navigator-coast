---
import Page from '../components/Page.astro';
import { PHOTOS } from '../data/photos';
import { INLINE } from '../data/inline';
---
<Page title="Photo credits" path="/photo-credits/" description="Every photograph on Navigator Coast, with its author, licence and source on Wikimedia Commons.">
  <p>We use photographs that are freely licensed (Wikimedia Commons and Unsplash) or supplied for editorial use by press libraries, always shown with their author and licence. We do not use scraped or AI-generated images, or photos where people are the subject. Images have been resized and cropped for the web; no other changes have been made.</p>
  <table class="credits-table">
    <thead><tr><th scope="col">Used for</th><th scope="col">Photograph</th><th scope="col">Author</th><th scope="col">Licence</th></tr></thead>
    <tbody>
      {PHOTOS.map((p) => (
        <tr><td>{p.place}</td><td><a href={p.source}>{p.title}</a></td><td>{p.author}</td><td><a href={p.licenceUrl}>{p.licence}</a></td></tr>
      ))}
    </tbody>
  </table>
  <h2>Photographs inside stories</h2>
  <p>Photographs from Unsplash are used under the <a href="https://unsplash.com/license">Unsplash License</a>. Photographs from Wikimedia Commons are used under the Creative Commons licence shown. Press photographs are used for editorial purposes under the terms of the press library they come from.</p>
  <table class="credits-table">
    <thead><tr><th scope="col">Story</th><th scope="col">Photograph</th><th scope="col">Author</th><th scope="col">Licence</th></tr></thead>
    <tbody>
      {INLINE.map((p) => (
        <tr><td><a href={`/stories/${p.post}/`}>{p.place}</a></td><td><a href={p.source}>{p.alt}</a></td><td>{p.author}</td><td><a href={p.licenceUrl}>{p.licence}</a></td></tr>
      ))}
    </tbody>
  </table>
</Page>
